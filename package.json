{
  "name": "plugin-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --runInBand",
    "gates:e2e": "bash ./scripts/quality-gates/validate-e2e.sh",
    "gates:a11y": "bash ./scripts/quality-gates/validate-accessibility.sh",
    "gates:contracts": "bash ./scripts/quality-gates/validate-contracts.sh",
    "gates:precommit": "bash ./scripts/quality-gates/pre-commit.sh",
    "gates:prepush": "bash ./scripts/quality-gates/pre-push.sh",
    "gates:ci": "bash ./scripts/quality-gates/ci.sh",
    "gates:postgres": "bash ./scripts/quality-gates/validate-postgres-migrations.sh",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@types/testing-library__react": "^10.2.0",
    "jest": "^30.2.0",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "jest-environment-jsdom": "^30.2.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
