generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  organizer
  admin
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) Prisma Adapter models
// Required by PrismaAdapter + strategy: 'database' in app/lib/auth/auth.ts.
// These are the standard Auth.js identity tables; the domain profile lives in
// UserAccount/OrganizerProfile below and is linked by email at sign-in time.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------

model UserAccount {
  id               String   @id @default(uuid())
  email            String   @unique
  role             UserRole @default(organizer)
  isAllowlistedAdmin Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organizerProfile OrganizerProfile?
}

model OrganizerProfile {
  id            String   @id @default(uuid())
  userAccountId String   @unique
  contactEmail  String
  displayName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
}
